# Configuration for Doxygen XML consumed by the Sphinx Breathe extension.

PROJECT_NAME = "@PROJECT_NAME@"
PROJECT_NUMBER = "@PROJECT_VERSION@"

INPUT = "@PROJECT_SOURCE_DIR@/include"
RECURSIVE = YES
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXCLUDE_PATTERNS = */ceres/* */detail/* */backend/eigen/* */backend/eve/* \
                   */backend/mad_eve/* */backend/plain/*

OUTPUT_DIRECTORY = "@DOXYGEN_OUTPUT_DIRECTORY@"
GENERATE_XML = YES
GENERATE_HTML = NO
GENERATE_LATEX = NO
XML_PROGRAMLISTING = NO
CREATE_SUBDIRS = NO

FULL_PATH_NAMES = YES
STRIP_FROM_PATH = "@PROJECT_SOURCE_DIR@/include" "@PROJECT_SOURCE_DIR@"
QUIET = YES
