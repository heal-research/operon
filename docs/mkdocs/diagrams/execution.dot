digraph execution {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.38, ranksep=0.5, pad=0.1];
  node [shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4F46E5", penwidth=2, fontname="Inter", fontsize=12, fontcolor="#1E1B4B", width=1.45, height=0.62];
  edge [color="#4F46E5", penwidth=1.5, arrowsize=0.75, fontname="Inter", fontsize=9, fontcolor="#6366F1"];

  tree [label="Tree +\ncoefficients"];
  dataset [label="Dataset +\nRange"];
  dispatch [label="ScalarDispatch\nfunctions + derivatives"];
  interpreter [label="Interpreter\nworker-local scratch"];
  values [label="Sampled\nvalues"];
  jacobian [label="Coefficient\nJacobian"];
  bounds [label="Interval / affine\ndomain bounds"];

  tree -> interpreter;
  dataset -> interpreter;
  dispatch -> interpreter;
  interpreter -> values [label="Evaluate"];
  interpreter -> jacobian [label="JacRev / JacFwd"];
  tree -> bounds;
  dispatch -> bounds;
}
