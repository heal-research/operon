digraph core_model {
  graph [rankdir=LR, bgcolor="transparent", nodesep=0.42, ranksep=0.55, pad=0.12];
  node [shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4F46E5", penwidth=2, fontname="Inter", fontsize=13, fontcolor="#1E1B4B", width=1.64, height=0.72];
  edge [color="#4F46E5", penwidth=1.5, arrowsize=0.75, fontname="Inter", fontsize=10, fontcolor="#312E81"];

  dataset [label="Dataset\ncolumns + weights"];
  problem [label="Problem\ntarget + ranges"];
  primitives [label="PrimitiveSet\nsymbols + arity"];
  creator [label="Creators /\nvariation"];
  tree [label="Tree\npostfix + metadata"];
  individual [label="Individual\ntree + fitness"];
  evaluator [label="Evaluator\nscores individual"];

  dataset -> problem [label="owned or borrowed"];
  problem -> primitives [label="owns"];
  problem -> creator [label="input hashes"];
  primitives -> creator;
  creator -> tree;
  tree -> individual;
  problem -> evaluator;
  individual -> evaluator;
}
