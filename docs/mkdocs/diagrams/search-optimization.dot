digraph search_optimization {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.35, ranksep=0.5, pad=0.1];
  node [shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4F46E5", penwidth=2, fontname="Inter", fontsize=14, fontcolor="#1E1B4B", width=1.5, height=0.65, fixedsize=true];
  edge [color="#4F46E5", penwidth=1.4, arrowsize=0.7, fontname="Inter", fontsize=10, fontcolor="#312E81"];

  prepare [label="Prepare\nsearch"];
  variation [label="Variation\noperators"];
  fit [label="Coefficient\nfit"];
  score [label="Score\nindividual"];
  reinsert [label="Reinsert\nelites"];
  parents [label="Next parents"];

  { rank=same; prepare; variation; }
  { rank=same; fit; score; }
  { rank=same; reinsert; parents; }

  prepare -> variation;
  variation -> fit;
  fit -> score;
  score -> reinsert;
  reinsert -> parents;
}
