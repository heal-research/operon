digraph search_optimization {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.34, ranksep=0.48, pad=0.1];
  node [shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4F46E5", penwidth=2, fontname="Inter", fontsize=12, fontcolor="#1E1B4B", width=1.45, height=0.62];
  edge [color="#4F46E5", penwidth=1.5, arrowsize=0.75, fontname="Inter", fontsize=9, fontcolor="#6366F1"];

  parents [label="Parent\npopulation"];
  prepare [label="Prepare\nevaluator / selectors"];
  select [label="Select and\ncreate offspring"];
  vary [label="Crossover +\nmutation"];
  fit [label="Optional\ncoefficient fit"];
  score [label="Evaluate\nfitness"];
  reinsert [label="Reinsert\nunder comparison"];

  parents -> prepare;
  prepare -> select;
  select -> vary;
  vary -> fit;
  fit -> score;
  score -> reinsert;
  reinsert -> parents [label="next generation"];
}
