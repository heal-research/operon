digraph evaluation {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.32, ranksep=0.45, pad=0.08];
  node [shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4F46E5", penwidth=2, fontname="Inter", fontsize=12, fontcolor="#1E1B4B", width=1.35, height=0.58, fixedsize=true];
  edge [color="#4F46E5", penwidth=1.4, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#6366F1"];

  evaluate [label="Sampled\nevaluation"];
  buffer [label="EvaluatedBuffer"];
  score [label="Score\nfitness"];
  error [label="ErrMax"];

  evaluate -> buffer [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#EEF2FF"><TR><TD><FONT COLOR="#1E1B4B">success</FONT></TD></TR></TABLE>>];
  buffer -> score;
  evaluate -> error [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#EEF2FF"><TR><TD><FONT COLOR="#1E1B4B">setup error</FONT></TD></TR></TABLE>>];
}
