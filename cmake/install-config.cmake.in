include(CMakeFindDependencyMacro)

# operon::core dependencies (compiled, but still Eigen/Ceres/L-BFGS-free;
# see CMakeLists.txt's operon_core target).
find_dependency(fluky CONFIG REQUIRED)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(libassert CONFIG REQUIRED)
find_dependency(Microsoft.GSL CONFIG REQUIRED)
find_dependency(mdspan CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(tl-expected CONFIG REQUIRED)
find_dependency(unordered_dense CONFIG REQUIRED)

# gtl and xxHash are also linked into operon_core, but PRIVATE and fully
# inlined -- normally invisible to a consumer. The exception is a STATIC
# operon_core: CMake still records static PRIVATE dependencies in the
# exported link interface, so they must be discovered for that build.
if(NOT @BUILD_SHARED_LIBS@)
    find_dependency(gtl CONFIG REQUIRED)
    find_dependency(xxHash CONFIG REQUIRED)
endif()

# A component request for core alone must not even discover backend
# dependencies. The default package request remains the full aggregate.
set(_operon_require_backend TRUE)
if(operon_FIND_COMPONENTS)
    set(_operon_require_backend FALSE)
    foreach(_operon_component IN LISTS operon_FIND_COMPONENTS)
        if(NOT _operon_component STREQUAL "core")
            set(_operon_require_backend TRUE)
        endif()
    endforeach()
endif()

if(_operon_require_backend)
    # already covered unconditionally above (core needs them too).
    find_dependency(Eigen3 CONFIG REQUIRED)
    if(@HAVE_ASMJIT@)
        find_dependency(asmjit CONFIG REQUIRED)
    endif()
    find_dependency(lbfgs CONFIG REQUIRED)
    find_dependency(infix-parser CONFIG REQUIRED)
    find_dependency(vstat CONFIG REQUIRED)
    find_dependency(pappus CONFIG REQUIRED)

    # operon::backend_adapter (INTERFACE) dependencies
    find_dependency(eve CONFIG REQUIRED)

    # operon::backend_adapter (PRIVATE) dependencies (needed for static library)
    find_dependency(AriaCsvParser CONFIG REQUIRED)
    find_dependency(Taskflow CONFIG REQUIRED)
    find_dependency(cpp-sort CONFIG REQUIRED)
    find_dependency(glaze CONFIG REQUIRED)
    find_dependency(ndsort CONFIG REQUIRED)
    find_dependency(gtl CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/operonTargets.cmake")

# Exported targets are the package components. Explicitly mark their
# component variables before check_required_components() evaluates a
# core-only request.
set(operon_core_FOUND TRUE)
set(operon_backend_adapter_FOUND TRUE)
set(operon_operon_FOUND TRUE)
check_required_components(operon)
